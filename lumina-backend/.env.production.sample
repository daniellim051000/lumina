# Production backend configuration (Railway)
# Set these as service variables in the Railway dashboard.

# Django core
SECRET_KEY=generate-a-strong-50-char-random-key
DEBUG=False
# Comma-separated. RAILWAY_PUBLIC_DOMAIN (auto-injected) is appended automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — injected by the Railway Postgres plugin. Reference it as:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# (When unset, the app falls back to the discrete DB_* vars below for local dev.)
# DATABASE_URL=

# Redis — injected by the Railway Redis plugin. Reference it as:
#   REDIS_URL=${{Redis.REDIS_URL}}
USE_REDIS=True
# REDIS_URL=

# CORS — must be the exact frontend origin (no wildcard with credentials).
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app
CORS_ALLOW_ALL_ORIGINS=False

# CSRF — needed for Django admin / Swagger over HTTPS (backend's own origin is
# appended automatically from RAILWAY_PUBLIC_DOMAIN).
CSRF_TRUSTED_ORIGINS=https://your-backend.up.railway.app

# Cookies — frontend and backend are on different *.up.railway.app subdomains,
# which are cross-site, so cross-site auth cookies require SameSite=None; Secure.
COOKIE_SECURE=True
COOKIE_SAMESITE=None

# HTTPS hardening (Railway terminates TLS and forwards X-Forwarded-Proto).
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# Rate limiting
AUTH_SIGNUP_RATE_LIMIT=5/m
AUTH_SIGNIN_RATE_LIMIT=5/m
