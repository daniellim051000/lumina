# Production frontend configuration (Railway)
# NOTE: Vite inlines these at BUILD time, so they must be set as service
# variables before `vite build` runs (not just at runtime).

# Point at the backend service's public domain, including the /api suffix.
VITE_API_BASE_URL=https://your-backend.up.railway.app/api

VITE_APP_NAME=Lumina
VITE_APP_VERSION=1.0.0
